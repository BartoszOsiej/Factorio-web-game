Output assets/factorio-demo.svg

Set FontSize 16
Set Width 960
Set Height 420
Set Shell bash
Set MarginColor "#0d1117"
Set Theme {
  "name": "factorio",
  "black": "#0d1117",
  "red": "#f85149",
  "green": "#3fb950",
  "yellow": "#e3b341",
  "blue": "#58a6ff",
  "magenta": "#a371f7",
  "cyan": "#39c5cf",
  "white": "#e6edf3",
  "brightBlack": "#8b949e"
}

Type "npm install -g novactorio"
Enter
Sleep 1s

Type "novactorio --help"
Enter
Sleep 800ms

Type "novactorio serve --port 3000"
Enter
Sleep 1s

Type "# Browser-based factory automation"
Enter
Sleep 500ms

Type "# Canvas 2D engine · TypeScript · co-op multiplayer"
Enter
Sleep 1s
